# Application Settings
PROJECT_NAME="Intelligent Personal Action App"
DEBUG=True
ENVIRONMENT=development

# Authentication & Security
SECRET_KEY=dev-secret-key-replace-in-production-random-token-xyz-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# SQLite Database (Async)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# AI Inference Provider: 'heuristic' (zero-cost offline), 'gemini', or 'openai'
AI_PROVIDER=heuristic
GEMINI_API_KEY=
OPENAI_API_KEY=

# Allowed CORS Origins (comma separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
